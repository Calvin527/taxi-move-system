# Local development settings
DJANGO_SECRET_KEY=django-insecure-change-this-for-local-development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Use SQLite first if you just want to run the project quickly.
# Change to False when you are ready to use PostgreSQL.
USE_SQLITE=True

# PostgreSQL settings. These are only used when USE_SQLITE=False.
DB_NAME=taxilink_db
DB_USER=taxilink_user
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
